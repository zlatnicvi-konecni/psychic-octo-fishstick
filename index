<!doctype html>
<html lang="cs">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{font-family:Arial,sans-serif;max-width:520px;margin:auto;padding:18px;background:#f7f7f7;color:#222}
h1{font-size:24px}
input{width:100%;box-sizing:border-box;padding:15px;font-size:20px;border:1px solid #bbb;border-radius:10px}
button{padding:18px;margin:6px 3px;font-size:20px;border:0;border-radius:12px;background:#e6e6e6}
.big{width:100%;font-size:24px}
.minus{font-weight:bold}
.card{background:white;border-radius:16px;padding:18px;margin-top:16px;box-shadow:0 2px 10px #0001}
.stock{font-size:42px;font-weight:bold;text-align:center;margin:12px}
.error{color:#b00020;font-weight:bold}
</style>
</head>
<body>
<h1>💎 Sklad briliantů</h1>
<input id="code" placeholder="Naskenuj / zadej kód" autocomplete="off">
<button class="big" onclick="loadStone()">🔎 Zjistit stav</button>
<div id="result"></div>

<script>
let stone=null;

function loadStone(){
  const code=document.getElementById('code').value.trim();
  if(!code) return;
  google.script.run
    .withSuccessHandler(showStone)
    .withFailureHandler(showError)
    .getStone(code);
}

function showStone(s){
  stone=s;
  document.getElementById('result').innerHTML=`
    <div class="card">
      <div><b>${esc(s.kind)} · ${esc(s.shape)}</b></div>
      <div>${esc(s.size)} mm · ${esc(s.color)} · ${esc(s.clarity)}</div>
      <div class="stock">${s.stock} ks</div>
      <button class="big minus" onclick="move(-1)">− 1 ks</button>
      <button class="big minus" onclick="move(-2)">− 2 ks</button>
      <button class="big minus" onclick="move(-5)">− 5 ks</button>
      <button class="big" onclick="move(1)">+ 1 ks</button>
    </div>`;
}

function move(n){
  if(!stone) return;
  google.script.run
    .withSuccessHandler(showStone)
    .withFailureHandler(showError)
    .moveStone(stone.code,n,'Mobil','Rychlá akce');
}

function showError(e){
  document.getElementById('result').innerHTML='<div class="card error">'+esc(e.message||String(e))+'</div>';
}

function esc(x){
  return String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
}

document.getElementById('code').addEventListener('keydown',e=>{
  if(e.key==='Enter') loadStone();
});
</script>
</body>
</html>
